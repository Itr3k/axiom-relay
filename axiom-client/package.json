{
  "name": "axiom-relay",
  "version": "0.2.2",
  "private": true,
  "description": "Retired legacy Axiom x402 and crypto-routing client. Historical source only; do not publish.",
  "license": "MIT",
  "author": "Elevated AI / N3RD Labs LLC",
  "homepage": "https://axiomrelay.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itr3k/axiom-relay.git"
  },
  "bugs": {
    "url": "https://github.com/Itr3k/axiom-relay/issues"
  },
  "keywords": [
    "axiom-relay",
    "legacy",
    "retired"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "default": "./dist/langchain/index.js"
    },
    "./elizaos": {
      "types": "./dist/elizaos/index.d.ts",
      "default": "./dist/elizaos/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "find dist -name '* 2.*' -o -name '* [0-9]' -type d | tr '\\n' '\\0' | xargs -0 rm -rf 2>/dev/null; true"
  },
  "peerDependencies": {
    "@x402/core": ">=2.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
