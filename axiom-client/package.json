{
  "name": "axiom-relay",
  "version": "0.2.2",
  "description": "Client for Axiom Relay \u2014 non-custodial routing for AI agents. Buy paid x402 APIs and prepare crypto swaps your wallet signs.",
  "license": "MIT",
  "author": "Elevated AI / N3RD Labs LLC",
  "homepage": "https://axiom.elevatedai.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itr3k/axiom-relay.git"
  },
  "bugs": {
    "url": "https://github.com/Itr3k/axiom-relay/issues"
  },
  "keywords": [
    "agent-payments",
    "agent-plugin",
    "agent-tools",
    "agentic-commerce",
    "ai-agents",
    "api-payments",
    "autonomous-agents",
    "base",
    "base-mainnet",
    "crypto-routing",
    "defi",
    "elevated-ai",
    "eliza",
    "elizaos",
    "langchain",
    "langgraph",
    "lifi",
    "llm-tools",
    "machine-commerce",
    "mcp",
    "micropayments",
    "non-custodial",
    "paid-api",
    "provider-discovery",
    "smart-router",
    "swap-routing",
    "usdc",
    "x402"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "default": "./dist/langchain/index.js"
    },
    "./elizaos": {
      "types": "./dist/elizaos/index.d.ts",
      "default": "./dist/elizaos/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "find dist -name '* 2.*' -o -name '* [0-9]' -type d | tr '\\n' '\\0' | xargs -0 rm -rf 2>/dev/null; true"
  },
  "peerDependencies": {
    "@x402/core": ">=2.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
